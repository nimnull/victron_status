# Victron MQTT Monitor - Secrets Configuration
# Copy this file to secrets.txt and fill in your values.
# secrets.txt is gitignored and will not be committed.

# WiFi Configuration
WIFI_SSID=your_wifi_ssid
WIFI_PASSWORD=your_wifi_password

# System 1 Configuration
MQTT_BROKER_URL_1=mqtt://192.168.1.10:1883
VICTRON_SYSTEM_ID_1=your_system_id_1

# System 2 Configuration
MQTT_BROKER_URL_2=mqtt://192.168.1.11:1883
VICTRON_SYSTEM_ID_2=your_system_id_2
